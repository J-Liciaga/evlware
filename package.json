{
	"name": "@evlware/source",
	"version": "0.0.0",
	"license": "MIT",
	"scripts": {
		"prepare": "husky",
		"serve:marketing": "nx serve marketing",
		"build:marketing": "nx build marketing --prod",
		"build:api:gateway": "nx build gateway --prod",
		"build:api:auth": "nx build auth-service --prod",
		"serve:pwa": "nx serve pwa",
		"build:pwa": "nx build pwa --pwa",
		"serve:gateway": "nx run gateway:run",
		"build:gateway": "nx build gateway",
		"build:prod:gateway": "nx build gateway",
		"check:gateway": "nx check gateway",
		"docker:build": "cd tools/scripts/docker && ./build-ava.sh",
		"docker:up": "cd tools/scripts/docker && ./deploy-ava.sh",
		"docker:down": "cd tools/scripts/docker && ./clean-up.sh",
		"start:notebook": "cd notebooks && jupyter notebook",
		"workspace:test-builds": "nx affected -t build",
		"workspace:lint": "nx affected --target lint --parallel 3",
		"workspace:affected": "nx affected",
		"workspace:affected-graph": "nx affected:graph",
		"workspace:format": "lint-staged",
		"workspace:clean": "rimraf dist dev_containers tmp",
		"workspace:run-migrations": "yarn nx migrate latest && yarn nx migrate --run-migrations"
	},
	"private": true,
